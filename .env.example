# --- PostgreSQL ---
POSTGRES_USER=mcpemail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mcpemail

# Used by the app container. When running via docker-compose, the host must
# be the service name "db". When running Next.js locally (outside Docker)
# against a Dockerized Postgres, use "localhost" instead.
DATABASE_URL=postgresql://mcpemail:change-me@db:5432/mcpemail

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-string
# Required when running behind a reverse proxy (Traefik/Nginx) on a VPS.
AUTH_TRUST_HOST=true
# Optional: secret used to sign OAuth access tokens issued via /oauth/authorize.
# Defaults to AUTH_SECRET if unset.
# OAUTH_JWT_SECRET=

# Optional: enables the "Continuer avec Google" button on /login. Sign-in
# only ever works as a *second* login method for a User that already exists
# (created through the invite-gated signup) - it never creates a new one
# (see lib/auth/auth.ts). Create credentials at
# https://console.cloud.google.com/apis/credentials with authorized
# redirect URI: <APP_BASE_URL>/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: same as above but for "Continuer avec GitHub". Create an OAuth
# App at https://github.com/settings/developers with authorization
# callback URL: <APP_BASE_URL>/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Encrypts mailbox passwords at rest (AES-256-GCM). Deliberately separate
# from AUTH_SECRET: a leak of one shouldn't compromise the other.
# Generate with: openssl rand -base64 32
MCP_MASTER_KEY=replace-with-another-long-random-string

# --- Transactional email (system-sent, not a pilotable Mailbox) ---
# The platform's own outgoing address for signup verification emails and
# organization invitations - unrelated to any user's IMAP/SMTP Mailbox.
# Required for the credentials signup flow (email verification) and for
# inviting members into an Organization to actually deliver anything;
# without it, those flows fail with a clear error (the email content is
# still logged server-side as a fallback for local/dev use).
# SMTP_FROM_HOST=smtp.yourprovider.com
# SMTP_FROM_PORT=465
# SMTP_FROM_SECURE=true
# SMTP_FROM_USER=apikey-or-username
# SMTP_FROM_PASSWORD=
# The "From:" address/name recipients see - defaults to SMTP_FROM_USER if unset.
# SMTP_FROM_ADDRESS=no-reply@yourdomain.fr
# SMTP_FROM_NAME=Mail MCP

# --- Reverse proxy (docker-compose.prod.yml only) ---
# The domain Traefik routes to this app, and the name of the external Docker
# network your existing Traefik instance is attached to (docker-compose.prod.yml
# joins it to reach the app container directly - no ports are published to the
# host). Not used by the plain docker-compose.yml (local/dev), which exposes
# APP_PORT on localhost instead.
DOMAIN=mail.yourdomain.fr
TRAEFIK_NETWORK=traefik

# --- App ---
# Host port the app is exposed on (local docker-compose.yml only; unused by
# docker-compose.prod.yml, which publishes no ports).
APP_PORT=3001
# Public URL this instance is reachable at (shown as the MCP server URL in
# Réglages). If unset, that display falls back to X-Forwarded-Host / Host
# headers, which is fine for a URL only ever shown back to the logged-in
# user themselves. REQUIRED, however, for links embedded in transactional
# emails (signup verification, org invites): those go out to a third party,
# so this app deliberately never falls back to a client-controllable header
# for them (see lib/http.ts's getTrustedAppBaseUrl) - signup/invite emails
# will fail with a clear error until this is set.
APP_BASE_URL=https://mail.yourdomain.fr

# --- Mailbox setup form defaults (optional) ---
# Pre-fills the IMAP/SMTP host fields when attaching a new mailbox, purely a
# UI convenience for instances where most users are on the same provider -
# left unset, the fields are just blank and every user types their own host.
# Ports/SSL already default sensibly (993/465, both over SSL) regardless.
# DEFAULT_IMAP_HOST=imap.mail.ovh.net
# DEFAULT_SMTP_HOST=smtp.mail.ovh.net

# --- Identity vs mailboxes ---
# Platform signup is invite-gated (no open public registration): create one
# with `npm run invite:create`, redeemed at /signup?token=... to create a
# User (just an email + password, no IMAP/SMTP yet). IMAP/SMTP mailboxes are
# attached afterwards from Réglages, once logged in - a User can attach any
# number of them, and share them with other Users via an Organization. See
# README for details.
